rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedInOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validGoals(goals) {
      return goals is map
        && goals.keys().hasAll(['calories', 'proteinG', 'carbsG', 'fatG'])
        && goals.keys().hasOnly(['calories', 'proteinG', 'carbsG', 'fatG'])
        && goals.calories is number && goals.calories > 0 && goals.calories <= 10000
        && goals.proteinG is number && goals.proteinG >= 0 && goals.proteinG <= 1000
        && goals.carbsG is number && goals.carbsG >= 0 && goals.carbsG <= 1000
        && goals.fatG is number && goals.fatG >= 0 && goals.fatG <= 1000;
    }

    function validProfile(uid) {
      let d = request.resource.data;
      return d.keys().hasAll([
          'uid', 'name', 'email', 'photoPath', 'dailyGoals', 'createdAt', 'updatedAt'
        ])
        && d.keys().hasOnly([
          'uid', 'name', 'email', 'photoPath', 'dailyGoals', 'createdAt', 'updatedAt'
        ])
        && d.uid == uid
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 80
        && d.email is string && d.email.size() <= 254
        && (d.photoPath == null ||
            (d.photoPath is string && d.photoPath ==
              ('users/' + uid + '/avatar/profile.jpg')))
        && validGoals(d.dailyGoals)
        && d.createdAt is timestamp && d.updatedAt is timestamp;
    }

    function validMeal() {
      let d = request.resource.data;
      return d.keys().hasAll([
          'name', 'mealType', 'consumedAt', 'localDayKey', 'servingGrams',
          'caloriesKcal', 'proteinG', 'carbsG', 'fatG', 'createdAt', 'updatedAt'
        ])
        && d.keys().hasOnly([
          'name', 'mealType', 'consumedAt', 'localDayKey', 'servingGrams',
          'caloriesKcal', 'proteinG', 'carbsG', 'fatG', 'createdAt', 'updatedAt'
        ])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 200
        && d.mealType in ['breakfast', 'lunch', 'dinner', 'snack']
        && d.consumedAt is timestamp
        && d.localDayKey is string &&
           d.localDayKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.servingGrams is number && d.servingGrams > 0 && d.servingGrams <= 20000
        && d.caloriesKcal is number && d.caloriesKcal >= 0 && d.caloriesKcal <= 50000
        && d.proteinG is number && d.proteinG >= 0 && d.proteinG <= 10000
        && d.carbsG is number && d.carbsG >= 0 && d.carbsG <= 10000
        && d.fatG is number && d.fatG >= 0 && d.fatG <= 10000
        && d.createdAt is timestamp && d.updatedAt is timestamp;
    }

    match /users/{uid} {
      allow get: if signedInOwner(uid);
      allow list: if false;

      allow create: if signedInOwner(uid)
        && validProfile(uid)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if signedInOwner(uid)
        && validProfile(uid)
        && resource.data.uid == uid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.email == resource.data.email
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'photoPath', 'dailyGoals', 'updatedAt'])
        && request.resource.data.updatedAt == request.time;

      allow delete: if false; // Account/data deletion needs explicit future design.

      match /meals/{mealId} {
        allow get, list: if signedInOwner(uid);
        allow create: if signedInOwner(uid)
          && validMeal()
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update: if signedInOwner(uid)
          && validMeal()
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['name', 'mealType', 'consumedAt', 'localDayKey',
                'servingGrams', 'caloriesKcal', 'proteinG', 'carbsG', 'fatG',
                'updatedAt'])
          && request.resource.data.updatedAt == request.time;

        allow delete: if signedInOwner(uid);
      }
    }
  }
}
